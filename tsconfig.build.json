{
  /* Build config: compiles the shipped surface only.
   * tests/ is deliberately absent — vitest runs .ts directly via esbuild, so
   * compiling tests would put dist/tests/ into the published package for no
   * reason. tsconfig.json still type-checks them. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false
  },
  "include": ["index.ts", "bin/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "template", "docs", "test-demo", "tests"]
}
